<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页：上面一块品牌蓝，下面一张浮起来的白卡片放表单 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="72dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                android:elevation="8dp"
                android:src="@drawable/logo_tile" />

            <TextView
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="信息科技教学平台"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.85"
                android:text="教师端 · 组卷、发考试、看成绩，随时随地"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="-44dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="教师登录"
                android:textColor="@color/text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="账号密码和网页版教师端相同"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="20dp"
                android:text="服务器地址" />

            <AutoCompleteTextView
                android:id="@+id/server"
                style="@style/Input"
                android:dropDownVerticalOffset="4dp"
                android:hint="例如 192.168.1.10:8080 或 exam.xx.cn"
                android:imeOptions="actionNext"
                android:inputType="textUri" />

            <TextView
                style="@style/Label"
                android:text="账号" />

            <EditText
                android:id="@+id/username"
                style="@style/Input"
                android:autofillHints="username"
                android:hint="教师用户名"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions|textVisiblePassword" />

            <TextView
                style="@style/Label"
                android:text="密码" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/password"
                    style="@style/Input"
                    android:autofillHints="password"
                    android:hint="密码"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingEnd="64dp" />

                <TextView
                    android:id="@+id/toggle_pwd"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="显示"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />
            </FrameLayout>

            <CheckBox
                android:id="@+id/remember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="记住密码，登录过期时自动重新登录"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/error_bg"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:elevation="2dp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="登 录"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="18dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
