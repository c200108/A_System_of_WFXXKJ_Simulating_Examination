<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：铺满的 WebView，上面叠着进度条、断网提示、出错页、启动等待页、「已保存」提示。
     root 的底色就是状态栏和手势条那一溜的颜色，跟网页顶栏、底部标签栏一致。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/warning_bg"
            android:elevation="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp"
            android:textColor="@color/warning"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 启动等待页：第一次打开页面之前，别让老师对着一片白 -->
        <LinearLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:src="@drawable/logo_small" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#1F2633"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="22dp"
                android:indeterminateTint="@color/primary" />
        </LinearLayout>

        <!-- 打不开页面时 -->
        <LinearLayout
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/page"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="52sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="连不上服务器"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/retry"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:text="重新连接"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/switch_server"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_plain"
                android:gravity="center"
                android:text="换个服务器地址"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 文件存好了：底部浮一条提示，点「打开」直接看 -->
        <LinearLayout
            android:id="@+id/saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="74dp"
            android:background="@drawable/toast_bg"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/saved_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/saved_open"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="打开"
                android:textColor="#8EA6FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
