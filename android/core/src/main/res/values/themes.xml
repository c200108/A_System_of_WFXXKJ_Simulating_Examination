<?xml version="1.0" encoding="utf-8"?>
<!-- 只用系统自带的 Material 主题，不引 AppCompat / Material Components 库，安装包小一大截。
     深浅色：values-night 里换成深色父主题，颜色按名字自动换。 -->
<resources>
    <style name="Wf.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/wf_primary</item>
        <item name="android:colorPrimaryDark">@color/wf_primary</item>
        <item name="android:colorAccent">@color/wf_primary</item>
        <item name="android:colorControlActivated">@color/wf_primary</item>
        <item name="android:colorControlHighlight">@color/wf_ripple</item>
        <item name="android:textColorPrimary">@color/wf_text</item>
        <item name="android:textColorSecondary">@color/wf_text2</item>
        <item name="android:textColorHint">@color/wf_text3</item>
        <item name="android:windowBackground">@color/wf_page</item>
        <item name="android:colorBackground">@color/wf_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Wf.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Wf.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Wf.Dialog</item>
    </style>

    <style name="Wf" parent="Wf.Base" />

    <style name="Wf.DialogBase" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorPrimary">@color/wf_primary</item>
        <item name="android:colorAccent">@color/wf_primary</item>
        <item name="android:colorControlActivated">@color/wf_primary</item>
        <item name="android:textColorPrimary">@color/wf_text</item>
        <item name="android:textColorSecondary">@color/wf_text2</item>
        <item name="android:windowBackground">@drawable/wf_dialog_bg</item>
    </style>

    <style name="Wf.Dialog" parent="Wf.DialogBase" />

    <!-- 自己画的底部弹层、全屏弹层用的无边框窗口 -->
    <style name="Wf.Sheet" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorAccent">@color/wf_primary</item>
        <item name="android:colorControlActivated">@color/wf_primary</item>
        <item name="android:textColorHint">@color/wf_text3</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
