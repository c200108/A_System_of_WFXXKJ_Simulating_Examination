# ---------------------------------------------------------------------------
# 用哪个数据库，只由这一行决定。代码不用改任何一处。
# 库不存在会在启动时自动创建（见 tools/ensure_db.py），不用手工建库。
#
# MySQL —— 多人使用、正式部署走这个。?charset=utf8mb4 不能省，中文题干靠它。
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/exam?charset=utf8mb4
#
# SQLite —— 一个人试用、不想装数据库时走这个，数据就是一个文件。
# DATABASE_URL=sqlite:///./data/app.db
#
# PostgreSQL —— 需要先 pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://exam:密码@127.0.0.1:5432/exam
#
# 密码里如果有 @ : / # 等符号，要按 URL 编码写（@ 写成 %40，# 写成 %23）
# ---------------------------------------------------------------------------

JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=系统管理员

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
