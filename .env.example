# 复制成 .env 后按实际情况修改，docker compose 会自动读取

# 拉镜像走哪个仓库。国内服务器直连 Docker Hub 基本拉不动，所以默认写成国内镜像源。
# mysql / python / node / nginx 四个基础镜像都从这里拉（见 docker-compose.yml
# 和两个 Dockerfile 的 ARG REGISTRY）。
# 能直连 Docker Hub 的机器（比如境外服务器）把它改成 docker.io 即可。
REGISTRY=docker.1ms.run

MYSQL_ROOT_PASSWORD=change_this_root_pwd
MYSQL_DATABASE=exam
MYSQL_USER=exam
MYSQL_PASSWORD=change_this_user_pwd

# 换一串长随机字符串；改了它所有人需要重新登录
JWT_SECRET=change_this_to_a_long_random_string

# 首次启动自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_pwd

# 学生/教师访问的端口，浏览器打开 http://服务器IP:8080
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

# 学生链接（考试、打字练习）用的对外地址，例如 http://203.0.113.10:8080
# 或 https://exam.school.edu.cn。留空则用老师浏览器当前地址。
# 老师会从服务器本机打开后台的话，务必填这一项，否则复制出的链接学生打不开。
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- HTTPS（可选）
# 两项都留空 = 只有 http，和以前一样。要开 HTTPS 先看 docs/部署指南.md「HTTPS」一节申请证书。
#
# SSL_CERT_DIR：宿主机上放证书的目录，里面要有 fullchain.pem 和 key.pem，
#   例如 acme.sh 装到的 /etc/ssl/ru6.top
# HTTPS_PORT：对外的 https 端口，一般就是 443。填了才会开 443，并把 http 的网页跳到 https
#   （/api/ 和 /uploads/ 在 http 上照旧能用，填着 http 地址的学生端 exe 不受影响）
# 开了以后记得把上面的 PUBLIC_BASE_URL 和 CORS_ORIGINS 改成 https 地址，如 https://exam.ru6.top
SSL_CERT_DIR=
HTTPS_PORT=
